<Window x:Class="PcDashboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PcDashboard Settings"
        Width="460"
        Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B98A5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111820" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderBrush" Value="#1E2A36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2A36" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111820" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderBrush" Value="#1E2A36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SETTINGS" Foreground="#E6EDF3" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Applied immediately. Saved to %AppData%\PcDashboard\settings.json."
                       Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="REFRESH INTERVAL (SECONDS, 1–10)" />
                <TextBox x:Name="RefreshBox" />

                <TextBlock Text="CPU ALERT THRESHOLD (°C)" />
                <TextBox x:Name="CpuThresholdBox" />

                <TextBlock Text="GPU ALERT THRESHOLD (°C)" />
                <TextBox x:Name="GpuThresholdBox" />

                <CheckBox x:Name="CsvCheckBox" Content="Write CSV log to %AppData%\PcDashboard\sensors.csv" />
                <CheckBox x:Name="StartupCheckBox" Content="Start with Windows" />
                <CheckBox x:Name="TopmostCheckBox" Content="Always on top" />
                <CheckBox x:Name="TrayCheckBox" Content="Minimize and close to tray" />
                <CheckBox x:Name="FahrenheitCheckBox" Content="Show Fahrenheit" />

                <TextBlock Text="IN-GAME OVERLAY"
                           Foreground="#4CC9F0"
                           FontSize="13"
                           Margin="0,16,0,6" />
                <CheckBox x:Name="OverlayCheckBox" Content="Show sensor overlay" />
                <TextBlock Text="OVERLAY CORNER" />
                <ComboBox x:Name="OverlayCornerBox" SelectedValuePath="Tag">
                    <ComboBoxItem Content="Top left" Tag="TopLeft" />
                    <ComboBoxItem Content="Top right" Tag="TopRight" />
                    <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                    <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                </ComboBox>
                <TextBlock Text="OVERLAY FONT SIZE (10–28)" />
                <TextBox x:Name="OverlayFontSizeBox" />
                <TextBlock Text="Toggle overlay with Ctrl+Alt+O. Works in borderless/windowed games."
                           TextWrapping="Wrap"
                           FontWeight="Normal"
                           Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Save" Click="Save_Click" Background="#2563EB" />
        </StackPanel>
    </Grid>
</Window>
