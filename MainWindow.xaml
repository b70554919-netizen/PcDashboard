<Window x:Class="PcDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Dashboard"
        Height="820"
        Width="1240"
        MinHeight="640"
        MinWidth="980"
        Background="#0B0F14"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111820" />
            <Setter Property="BorderBrush" Value="#1E2A36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B98A5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#17212B" />
            <Setter Property="Foreground" Value="#8B98A5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Foreground" Value="#E6EDF3" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#111820" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#17212B" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel>
                <TextBlock Text="PC Dashboard" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="LibreHardwareMonitor • live sensors"
                           Foreground="#8B98A5"
                           FontSize="12"
                           Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="#8B98A5"
                           Text="starting..." />
                <Button Content="Settings" Style="{StaticResource HeaderButton}" Click="Settings_Click" />
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CPU TEMP" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="CpuTempText" Text="—" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="GPU TEMP" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="GpuTempText" Text="—" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="CPU LOAD" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="CpuLoadText" Text="—" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="GPU LOAD" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="GpuLoadText" Text="—" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,100,0,0" VerticalAlignment="Top">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="RAM" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="RamText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="VRAM" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="VramText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,8,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="DISK TEMP" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="DiskTempText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="CPU POWER" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="CpuPowerText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="TEMPERATURE HISTORY" Style="{StaticResource CardLabel}" />
                <Canvas x:Name="ChartCanvas" Margin="0,28,0,0" ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged">
                    <Line x:Name="GridTop" Stroke="#1E2A36" StrokeThickness="1" StrokeDashArray="2 4" />
                    <Line x:Name="GridMid" Stroke="#1E2A36" StrokeThickness="1" StrokeDashArray="2 4" />
                    <Line x:Name="GridBottom" Stroke="#1E2A36" StrokeThickness="1" StrokeDashArray="2 4" />
                    <TextBlock x:Name="ChartMaxLabel" Text="100°C" Foreground="#5B6B7A" FontSize="10" />
                    <TextBlock x:Name="ChartMidLabel" Text="50°C" Foreground="#5B6B7A" FontSize="10" />
                    <TextBlock x:Name="ChartMinLabel" Text="0°C" Foreground="#5B6B7A" FontSize="10" />
                    <Polyline x:Name="CpuLine" Stroke="#4CC9F0" StrokeThickness="2" />
                    <Polyline x:Name="GpuLine" Stroke="#F72585" StrokeThickness="2" />
                </Canvas>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="SensorGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="#111820"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#0E141B"
                      SelectionMode="Single"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Hardware" Binding="{Binding Hardware}" Width="240" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                    <DataGridTextColumn Header="Sensor" Binding="{Binding Sensor}" Width="*" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
